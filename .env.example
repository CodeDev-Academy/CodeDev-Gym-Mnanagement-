# =============================================================================
# Gym Management System - Coolify & Production Environment Configuration
# =============================================================================

# PostgreSQL Database Credentials
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=your_strong_postgres_password_here

# Django Backend Configuration
DJANGO_SECRET_KEY=generate_a_long_random_secret_key_here
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://app.yourgym.com,http://localhost:5174

# Database URL (automatically constructed in docker-compose, or paste direct in Coolify)
# DATABASE_URL=postgres://gym_user:your_strong_postgres_password_here@db:5432/gym_db

# Frontend Build-time API Base URL
# If hosting behind a custom domain on Coolify, set to your backend API URL:
VITE_API_BASE_URL=https://api.yourgym.com/api/

# n8n Automation Webhook URL (for WhatsApp auto-dispatch receipts & reminders)
N8N_WEBHOOK_URL=https://n8n.yourcoolify.com/webhook/gym-receipt-dispatch

# Host Port Mappings (Optional, defaults to 8001 and 5174)
BACKEND_PORT=8001
FRONTEND_PORT=5174
