  {
    "name": "Abuja Gym \u2014 Daily Owner Summary Report",
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 7 * * *"
              }
            ]
          }
        },
        "id": "schedule-trigger-7am",
        "name": "Schedule Daily 7AM WAT",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          220,
          300
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ $vars.API_BASE_URL || 'https://gym-api.up.railway.app' }}/api/dashboard/daily-summary/?date=yesterday",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "=Token {{ $vars.API_TOKEN || 'YOUR_AUTOMATION_BOT_TOKEN' }}"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "responseFormat": "json"
              }
            },
            "retry": {
              "retry": {
                "maxTries": 3,
                "waitBetweenTries": 5000
              }
            }
          }
        },
        "id": "http-fetch-summary",
        "name": "Fetch Yesterday Summary",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          460,
          300
        ]
      },
      {
        "parameters": {
          "language": "javaScript",
          "jsCode": "const data = $input.item.json;\n\nfunction toE164(phone) {\n  if (!phone) return '';\n  let digits = String(phone).replace(/\\D/g, '');\n  if (digits.startsWith('0') && digits.length === 11) {\n    digits = '234' + digits.slice(1);\n  } else if (digits.startsWith('234') && digits.length === 13) {\n    // already 234\n  }\n  return 'whatsapp:+' + digits;\n}\n\nconst revenue = Number(data.revenue_today || 0);\nconst formattedRevenue = '\u20a6' + revenue.toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst dateStr = data.formatted_date || data.date || 'Yesterday';\nconst checkins = data.checkins_today || 0;\nconst uniqueCheckins = data.unique_checkins_today || 0;\nconst newMembers = data.new_members_today || 0;\nconst expiring = data.expiring_today || 0;\n\nconst rawOwnerPhone = $vars.OWNER_WHATSAPP_NUMBER || '+2349038446407';\nconst ownerPhone = toE164(rawOwnerPhone);\n\nlet activityNote = 'Great workout momentum across all shifts!';\nif (checkins === 0 && revenue === 0) {\n  activityNote = 'Rest day / Gym closed (0 check-ins recorded).';\n}\n\nconst messageBody = `\ud83d\udcca *ABUJA GYM \u2014 EXECUTIVE DAILY REPORT*\\n` +\n  `\ud83d\udcc5 *Date:* ${dateStr} (Full 24h Wrap-up)\\n` +\n  `\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n` +\n  `\ud83d\udcb0 *Revenue Collected:* ${formattedRevenue}\\n` +\n  `\ud83c\udfcb\ufe0f *Total Check-ins:* ${checkins} workouts (${uniqueCheckins} unique athletes)\\n` +\n  `\u2728 *New Members Enrolled:* ${newMembers}\\n` +\n  `\u26a0\ufe0f *Subscriptions Expired:* ${expiring}\\n` +\n  `\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\\n` +\n  `\ud83d\udca1 ${activityNote}\\n\\n` +\n  `Have a productive day ahead at the gym! \ud83d\udcaa`;\n\nreturn {\n  json: {\n    owner_phone: ownerPhone,\n    date: dateStr,\n    revenue: formattedRevenue,\n    checkins: checkins,\n    unique_checkins: uniqueCheckins,\n    new_members: newMembers,\n    expiring: expiring,\n    message_body: messageBody\n  }\n};"
        },
        "id": "code-format-card",
        "name": "Format Executive Briefing Card",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          700,
          300
        ]
      },
      {
        "parameters": {
          "resource": "message",
          "operation": "sendMessage",
          "chatId": "5433612668",
          "text": "={{ $json.message_body }}",
          "additionalFields": {
            "parse_mode": "Markdown",
            "appendAttribution": false
          }
        },
        "id": "telegram-send-owner",
        "name": "Send Telegram Report to Owner",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "position": [
          940,
          300
        ],
        "credentials": {
          "telegramApi": {
            "id": "A3rsRd8wXZFt93qG",
            "name": "Dr ai_bot"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
    "connections": {
      "Schedule Daily 7AM WAT": {
        "main": [
          [
            {
              "node": "Fetch Yesterday Summary",
              "type": "main",
              "index": 0
            }
          ]
        ]
