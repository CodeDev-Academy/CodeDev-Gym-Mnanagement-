      {
        "parameters": {
          "language": "javaScript",
          "jsCode": "const item = $input.item.json;\n\n// Edge Case 2: Strict E.164 sanitizer\nfunction toE164(phone) {\n  if (!phone) return '';\n  let digits = String(phone).replace(/\\D/g, '');\n  if (digits.startsWith('0') && digits.length === 11) {\n    digits = '234' + digits.slice(1);\n  } else if (digits.startsWith('234') && digits.length === 13) {\n    // already Nigerian international without +\n  }\n  return 'whatsapp:+' + digits;\n}\n\nconst rawPhone = item.phone_number || '';\nconst formattedPhone = toE164(rawPhone);\nconst memberName = item.member_name || 'Valued Member';\nconst planName = item.plan_name || 'Gym Pass';\nconst daysLeft = item.days_left !== undefined ? item.days_left : 3;\nconst endDate = item.end_date || '';\n\n// Edge Case 1: Friendly personalized message copy\nconst messageBody = `Hi ${memberName}! \ud83c\udfcb\ufe0f\u200d\u2642\ufe0f\\n\\nYour ${planName} pass at Abuja Gym expires in ${daysLeft} day${daysLeft === 1 ? '' : 's'} (${endDate}).\\n\\nRenew early so your training routine stays smooth and uninterrupted! We look forward to seeing you on the gym floor. \ud83d\udcaa`;\n\nreturn {\n  json: {\n    subscription_id: item.id || item.subscription_id,\n    member_id: item.member_id,\n    member_name: memberName,\n    raw_phone: rawPhone,\n    whatsapp_to: formattedPhone,\n    days_left: daysLeft,\n    end_date: endDate,\n    message_body: messageBody,\n    is_valid_phone: formattedPhone.length >= 13\n  }\n};"
        },
