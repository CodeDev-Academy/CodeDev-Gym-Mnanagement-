# ==========================================
# Gym Management System - Environment Config
# ==========================================

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: In Coolify, attach a PostgreSQL resource and paste its internal connection string here:
DATABASE_URL=postgresql://postgres:%40Babson26@localhost:5432/gym_db

# Application Mode (True for local development, False for production / Coolify)
DEBUG=False

# Django Secret Key (generate a random 50+ character string for production)
SECRET_KEY=generate_a_secure_random_50_character_secret_key_here

# Allowed Hosts (comma-separated domains or IP addresses)
# In Coolify, add your backend application domain (e.g. api.yourgym.com)
ALLOWED_HOSTS=localhost,127.0.0.1,.coolify.io

# Cross-Origin Resource Sharing (CORS)
# In production, set CORS_ALLOW_ALL_ORIGINS=False and specify your frontend domain:
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5174,https://app.yourgym.com

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=http://localhost:5174,https://app.yourgym.com

# Automation Bot Token for background tasks / n8n workflows
AUTOMATION_BOT_TOKEN=generate_a_40_char_token_for_n8n_workflows_here

# Gunicorn tuning (optional)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
