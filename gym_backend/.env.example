# ==========================================
# Gym Management System - Environment Config
# ==========================================

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: If password contains special characters like '@', percent-encode it (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres:%40Babson26@localhost:5432/gym_db

# Application Mode (True for local development, False for production / Coolify)
DEBUG=True

# Django Secret Key (generate a random 50+ character string for production)
SECRET_KEY=django-insecure-gym-management-local-dev-secret-key-2026

# Allowed Hosts (comma-separated domains or IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOW_ALL_ORIGINS=True
# In production, set CORS_ALLOW_ALL_ORIGINS=False and specify origins:
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Automation Bot Token for background tasks / n8n workflows
AUTOMATION_BOT_TOKEN=gym_automation_bot_local_secret_token_2026

